{
  "name": "community",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"src/lib/server/__tests__/**/*.test.js\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@jitsi/react-sdk": "^1.4.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.115.0",
    "@vercel/blob": "^2.8.0",
    "dompurify": "^3.4.14",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.40.0",
    "next": "16.3.0",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "protobufjs@7.6.5": true,
    "esbuild@*": true,
    "@esbuild/linux-x64@*": true,
    "@swc/core@*": true,
    "@parcel/watcher@*": true,
    "@prisma/engines@*": true,
    "@prisma/client@*": true,
    "@prisma/composer@*": true,
    "@prisma/composer-cli@*": true,
    "@prisma/orm-toolchain@*": true
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  }
}
