# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.aider*

# One-off pre-migration data snapshots (pre-shift timestamps, PII). Kept locally
# as a rollback aid for the timestamptz migration, not in version control.
*-pre-timestamptz-backup.json

# Role-change backups written by scripts/limit-owners.mjs before it writes to
# the User table. They contain member names and emails, so they stay local.
scripts/.role-backup-*.json
