rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return isSignedIn() && me().exists ? me().data.role : '';
    }

    function isOwner() {
      return isSignedIn() && role() == 'owner';
    }

    function isModerator() {
      return isSignedIn() && (role() in ['owner', 'moderator']);
    }

    function isNotSuspended() {
      return isSignedIn() && (!me().exists || me().data.suspended != true);
    }

    function isActiveSub() {
      return isNotSuspended();
    }

    function isSpaceMember(spaceId) {
      return spaceId == null || spaceId == ''
        || get(/databases/$(database)/documents/spaceMembers/$(spaceId + '_' + request.auth.uid)).exists;
    }

    function isGroupMember(groupId) {
      return groupId == null || groupId == ''
        || get(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid)).exists;
    }

    function canReadPost(post) {
      return isOwner()
        || (isActiveSub()
          && isSpaceMember(post.spaceId)
          && isGroupMember(post.groupId));
    }

    function canReadCourse(courseId) {
      let course = get(/databases/$(database)/documents/courses/$(courseId)).data;
      return isOwner()
        || (isActiveSub()
          && course != null
          && course.status == 'published');
    }

    function canReadRoom(room) {
      return isOwner()
        || (isActiveSub()
          && isSpaceMember(room.spaceId)
          && isGroupMember(room.groupId));
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwner());
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'member';
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'headline', 'location', 'notifications'])
        || isOwner();
      allow delete: if isOwner();
    }

    match /subscriptions/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn() && canReadRoom(resource.data);
      allow create: if isOwner();
      allow update, delete: if isOwner();

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && canReadRoom(get(/databases/$(database)/documents/rooms/$(roomId)).data);
        allow write: if false;
      }

      match /signals/{signalId} {
        allow read: if isSignedIn()
          && canReadRoom(get(/databases/$(database)/documents/rooms/$(roomId)).data);
        allow write: if false;
      }
    }

    match /events/{eventId} {
      allow read: if isSignedIn() && (isActiveSub() || isOwner());
      allow create, update, delete: if isOwner();
    }

    match /rsvps/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner());
      allow create: if isSignedIn() && isActiveSub()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['eventId', 'occurrenceId', 'userId', 'name', 'createdAt']);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /availability/{availId} {
      allow read: if isSignedIn() && isActiveSub();
      allow write: if false;
    }

    match /availabilityRsvps/{id} {
      allow read: if isSignedIn() && isActiveSub();
      allow write: if false;
    }

    match /pollVotes/{voteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if isSignedIn()
        && request.auth.uid == resource.data.userId;
    }

    match /posts/{postId} {
      allow read: if isSignedIn() && (resource.data.authorId == request.auth.uid || canReadPost(resource.data));
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'text', 'imageUrl', 'createdAt',
          'groupId', 'spaceId', 'kind', 'hashtags'
        ])
        && request.resource.data.text.size() <= 5000
        && request.resource.data.imageUrl.size() <= 2048;
      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'imageUrl'])
          && request.resource.data.text.size() <= 5000
          && request.resource.data.imageUrl.size() <= 2048)
        || (isModerator()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']))
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isModerator());

      match /comments/{commentId} {
        allow read: if isSignedIn() && (resource.data.authorId == request.auth.uid
          || canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data));
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.text.size() <= 2000
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isModerator());
      }
    }

    match /spaces/{spaceId} {
      allow read: if isSignedIn() && (isActiveSub() || isOwner());
      allow create, update, delete: if isOwner();
    }

    match /spaceMembers/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner());
      allow create, update, delete: if false;
    }

    match /gamification/{uid} {
      allow read: if isSignedIn() && (isActiveSub() || isOwner() || request.auth.uid == uid);
      allow create, update, delete: if false;
    }

    match /roomEvents/{eventId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'roomId', 'roomName', 'joinedAt']);
      allow update, delete: if false;
    }

    match /courses/{courseId} {
      allow read: if isSignedIn() && (isOwner() || (isActiveSub() && resource.data.status == 'published'));
      allow create: if isOwner();
      allow update, delete: if isOwner();
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn() && canReadCourse(resource.data.courseId);
      allow create, update, delete: if isOwner();
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn() && canReadCourse(resource.data.courseId);
      allow create, update, delete: if isOwner();
    }

    match /progress/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /purchases/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && isNotSuspended();
      allow create: if isOwner();
      allow update, delete: if isOwner();
    }

    match /groupMembers/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isOwner());
      allow create, update, delete: if false;
    }

    match /groupTopics/{topicId} {
      allow read: if isSignedIn() && isNotSuspended();
      allow create, update, delete: if false;
    }

    match /topicThreads/{threadId} {
      allow read: if isSignedIn() && isNotSuspended();
      allow create, update, delete: if false;
    }

    match /topicReplies/{replyId} {
      allow read: if isSignedIn() && isNotSuspended();
      allow create, update, delete: if false;
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /pushSubscriptions/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantIds.hasAny([request.auth.uid]);
        allow create, update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() && isModerator();
      allow create, update, delete: if false;
    }

    match /collections/{id} {
      allow read, create, update, delete: if false;
    }

    match /settings/{id} {
      allow read, create, update, delete: if false;
    }

    match /hostAssignments/{id} {
      allow read, create, update, delete: if false;
    }

    match /announcements/{id} {
      allow read, create, update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read, create, update, delete: if false;
    }
  }
}
