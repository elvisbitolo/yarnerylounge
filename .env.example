# ===== Supabase (auth + Postgres) =====
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Vercel Blob (file uploads) =====
# From Vercel dashboard → Storage → Blob → Create store.
BLOB_READ_WRITE_TOKEN=

# ===== Shopify (transactions) =====
SHOPIFY_ACCESS_TOKEN=
# Webhook secret for HMAC verification of /api/webhooks/shopify (from
# Shopify admin → Settings → Notifications → Webhooks).
SHOPIFY_WEBHOOK_SECRET=
# Public pricing/checkout page that /plan-expired points paying users back to.
NEXT_PUBLIC_SHOPIFY_PRICING_URL=
# Open-access switch (defaults to open when unset). While open, every signed-in
# user gets full access (plan "moving-in") and /plan-expired is bypassed.
#   not set / true -> open access for all authenticated users
#   false          -> paid-plan gate re-enabled
SHOPIFY_OPEN_ACCESS=true

# ===== JaaS (8x8 video rooms) =====
# From your JaaS developer tenant (https://jaas.8x8.vc → your tenant → API Keys).
# JITSI_APP_ID is the tenant ID, e.g. vpaas-magic-cookie-XXXXXXXXXXXX.
# JITSI_API_KEY_ID is a SEPARATE credential (shown in the JaaS console under
# "API Keys") used as the JWT header `kid`. NOT the AppID and NOT the private key.
# JITSI_PRIVATE_KEY is the PEM private key paired with the API Key ID.
JITSI_APP_ID=
JITSI_API_KEY_ID=
JITSI_PRIVATE_KEY=

# ===== Web push notifications (optional) =====
# Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@christa-patel.com

# ===== Cron (Vercel) =====
# Used by vercel.json cron auth. Must be a long random string.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Email (optional — for comment/RSVP notifications) =====
# If RESEND_API_KEY is not set, emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM=Community <no-reply@christa-patel.com>

# ===== Chat message encryption (REQUIRED) =====
# 256-bit key, base64-encoded. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical on every deployment. Messages are stored AES-256-GCM
# encrypted at rest. If this key is missing, sending a chat message FAILS
# CLOSED (the app refuses to store plaintext) so nothing is ever leaked.
MESSAGE_ENCRYPTION_KEY=

# ===== Postgres (Supabase) via Prisma =====
# The app prefers DATABASE_URL (pooler). If it is not set, it falls back to
# POSTGRES_PRISMA_URL — the name the Supabase + Vercel integration sets.
DATABASE_URL=
# Direct/non-pooling connection for one-off scripts.
DIRECT_URL=
# Vercel/Supabase standard names (used automatically when the above are empty).
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=