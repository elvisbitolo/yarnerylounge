# ===== Supabase (auth + Postgres) =====
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Vercel Blob (file uploads) =====
# From Vercel dashboard → Storage → Blob → Create store.
BLOB_READ_WRITE_TOKEN=

# ===== Shopify (transactions) =====
SHOPIFY_ACCESS_TOKEN=
# Webhook secret for HMAC verification of /api/webhooks/shopify (from
# Shopify admin → Settings → Notifications → Webhooks).
SHOPIFY_WEBHOOK_SECRET=
# Public pricing/checkout page that /plan-expired points paying users back to.
NEXT_PUBLIC_SHOPIFY_PRICING_URL=
# Open-access switch (defaults to open when unset). While open, every signed-in
# user gets full access (plan "moving-in") and /plan-expired is bypassed.
#   not set / true -> open access for all authenticated users
#   false          -> paid-plan gate re-enabled
SHOPIFY_OPEN_ACCESS=true

# ===== JaaS (8x8 video rooms) =====
# From your JaaS developer tenant (https://jaas.8x8.vc → your tenant → API Keys).
# JITSI_APP_ID is the tenant ID, e.g. vpaas-magic-cookie-XXXXXXXXXXXX.
# JITSI_API_KEY_ID is a SEPARATE credential (shown in the JaaS console under
# "API Keys") used as the JWT header `kid`. NOT the AppID and NOT the private key.
# JITSI_PRIVATE_KEY is the PEM private key paired with the API Key ID.
JITSI_APP_ID=
JITSI_API_KEY_ID=
JITSI_PRIVATE_KEY=

# Recording library. JITSI_WEBHOOK_SECRET is the per-endpoint secret from the
# JaaS console (JaaS > Webhooks > Add endpoint > Reveal secret). It is the key
# for the X-Jaas-Signature HMAC on POST /api/webhooks/jitsi — the endpoint
# stays unauthenticated to JaaS and relies on this instead. The webhook returns
# 503 while it is unset.
JITSI_WEBHOOK_SECRET=
# Billable per-minute add-on. Set to "off" to withhold the transcription flag
# from every member's JWT without a deploy. Leave unset/"on" to keep the
# Jitsi > Subtitles menu available to all members.
JITSI_TRANSCRIPTION=on

# ===== Recording library storage =====
# The /recordings page shows members a "used of limit" bar. The limit is a
# display budget only (nothing is enforced); it defaults to 5 GB when unset,
# which is why a fresh deployment reads "of 5.0 GB". Set it to the Storage
# allowance that matches your Supabase plan (Free 1, Pro/Team 100) so the bar
# is meaningful.
RECORDINGS_STORAGE_LIMIT_GB=
# App-level ceilings for pulling a JaaS recording into Storage. The effective
# per-file ceiling is the Supabase Global file size limit (Dashboard > Storage >
# Settings); these only guard our own function. Both default to 2 GiB / 384 MiB.
RECORDINGS_MAX_UPLOAD_BYTES=
RECORDINGS_MAX_IN_MEMORY_BYTES=

# ===== Web push notifications (optional) =====
# Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@christa-patel.com

# ===== Cron (Vercel) =====
# Used by vercel.json cron auth. Must be a long random string.
CRON_SECRET=

# ===== Auth origins =====
# Base URL used for OAuth / password-reset / email-verification redirects.
# Must be a real http(s) origin — a placeholder here silently breaks every
# sign-in link. Keep it identical to NEXT_PUBLIC_CANONICAL_HOST in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The one public origin for the app. Everything on the app's own domain list
# below is 308-redirected here, because the session cookie is host-only and a
# member served from two different hosts is signed out on one of them.
NEXT_PUBLIC_CANONICAL_HOST=www.christasspeakeasy.com

# Comma-separated hosts that serve this same app and must be folded onto the
# canonical origin. Add any domain that links to or points at the live site —
# Vercel per-project/per-deploy domains change on rename or transfer, and a host
# missing from this list shows members a signed-out app.
NEXT_PUBLIC_OWN_HOSTS=www.christasspeakeasy.com,christasspeakeasy.com,christaspeakeasy.com,yarnerylounge.vercel.app,community-elvisbitolo11-8702s-projects.vercel.app,elvisbitolo11-8702s-projects.vercel.app

# ===== Email (optional — for comment/RSVP notifications) =====
# If RESEND_API_KEY is not set, emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM=Community <no-reply@christa-patel.com>

# ===== Chat message encryption (REQUIRED) =====
# 256-bit key, base64-encoded. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical on every deployment. Messages are stored AES-256-GCM
# encrypted at rest. If this key is missing, sending a chat message FAILS
# CLOSED (the app refuses to store plaintext) so nothing is ever leaked.
MESSAGE_ENCRYPTION_KEY=

# ===== Postgres (Supabase) via Prisma =====
# The app prefers DATABASE_URL (pooler). If it is not set, it falls back to
# POSTGRES_PRISMA_URL — the name the Supabase + Vercel integration sets.
DATABASE_URL=
# Direct/non-pooling connection for one-off scripts.
DIRECT_URL=
# Vercel/Supabase standard names (used automatically when the above are empty).
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=