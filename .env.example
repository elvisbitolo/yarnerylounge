# ===== Firebase Web (client SDK) — from Firebase console → Project settings → Your apps =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=christa-patel.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=christa-patel
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=310624372536
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin (server SDK) =====
# Either paste the whole service-account JSON (downloaded from
# Project settings → Service accounts → Generate new private key) OR set the three fields below.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=christa-patel
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===== LiveKit Cloud =====
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ===== Vercel Blob (file uploads) =====
# From Vercel dashboard → Storage → Blob → Create store. If left empty,
# uploaded avatars fall back to base64 stored in Firestore.
BLOB_READ_WRITE_TOKEN=

# ===== Shopify (transactions) =====
SHOPIFY_ACCESS_TOKEN=
# Webhook secret for HMAC verification of /api/webhooks/shopify (from
# Shopify admin → Settings → Notifications → Webhooks).
SHOPIFY_WEBHOOK_SECRET=
# Public pricing/checkout page that /plan-expired points paying users back to.
NEXT_PUBLIC_SHOPIFY_PRICING_URL=

# ===== Web push notifications (optional) =====
# Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@christa-patel.com

# ===== Cron (Vercel) =====
# Used by vercel.json cron auth. Must be a long random string.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Email (optional — for comment/RSVP notifications) =====
# If RESEND_API_KEY is not set, emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM=Community <no-reply@christa-patel.com>

# ===== Chat message encryption (REQUIRED) =====
# 256-bit key, base64-encoded. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical on every deployment. Messages are stored AES-256-GCM
# encrypted at rest. If this key is missing, sending a chat message FAILS
# CLOSED (the app refuses to store plaintext) so nothing is ever leaked.
MESSAGE_ENCRYPTION_KEY=
